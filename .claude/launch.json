{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "anajak-erp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "anajak-erp-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:demo"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "anajak-erp-proto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3011"
      ],
      "port": 3011
    }
  ]
}
