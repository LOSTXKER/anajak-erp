{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma db push:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npm run db:push:*)",
      "Bash(npm run verify:e2e:*)",
      "Bash(npm run verify:moneygate:*)",
      "Bash(npm run verify:ops:*)",
      "Bash(npm run verify:bn:*)",
      "Bash(npm run verify:wht:*)",
      "Bash(npm run verify:terms:*)",
      "Bash(npm run verify:p02:*)",
      "Bash(npm run verify:qc:*)",
      "Bash(npm run verify:tax:*)",
      "Bash(npm run verify:crm:*)",
      "Bash(npm run verify:pack:*)",
      "Bash(npm run verify:files:*)",
      "Bash(npm run verify:storage:*)",
      "Bash(npm run verify:artwork:*)",
      "Bash(npm run verify:upload:*)",
      "Bash(npm run verify:status:*)",
      "Bash(npm run verify:confirm:*)",
      "Bash(npm run verify:revision:*)",
      "Bash(npm run verify:mcp:*)",
      "Bash(npm run verify:co:*)",
      "Bash(npm run verify:softdel:*)",
      "Bash(npm run verify:oshare:*)",
      "Bash(npm run verify:docsnap:*)",
      "Bash(npm run key:agent:*)",
      "Bash(node --env-file=.env scripts/create-owner.ts:*)",
      "Bash(tsx scripts/create-owner.ts:*)",
      "Bash(npx tsx scripts/create-owner.ts:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(npx vercel --prod:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/progress-on-start.mjs\""
          }
        ]
      }
    ]
  }
}
