# คัดลอกเป็น .env เฉพาะเมื่อยังไม่มีไฟล์ แล้วเติมค่าของสภาพแวดล้อมที่จะใช้
# ห้ามใส่ค่าจริงในไฟล์ตัวอย่างหรือ commit ไฟล์ .env
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
# Transaction mode pooler (port 6543) for serverless (Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for Prisma migrations; ห้าม db push
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Anajak Stock API
ANAJAK_STOCK_API_URL=https://stock.anajak.com/api
ANAJAK_STOCK_API_KEY=your-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Temporary Production V2 rollout switch. Remove after the accepted rollback window.
PRODUCTION_V2_ENABLED=0
# Destructive V2 smoke verifier stays disabled unless this and the DB sentinel are set explicitly.
PRODUCTION_V2_VERIFY_TOKEN=

# Cron (/api/cron/overdue และ /api/cron/stock-reservations) — ตั้งบน Vercel ให้ส่ง Bearer
# ไม่ตั้ง = ทั้งสอง route ปฏิเสธคำขอ (fail-closed); หน้า billing มี sweep แยก
CRON_SECRET=your-random-secret
